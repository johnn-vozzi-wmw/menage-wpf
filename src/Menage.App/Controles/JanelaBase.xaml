<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:c="clr-namespace:Menage.App.Controles">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Menage;component/Tema/Tokens.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <!-- Toda janela do app: barra própria, conteúdo, diálogos, avisos, paleta Ctrl+K e a camada da troca de tema. -->
  <Style x:Key="Janela.Base" TargetType="c:JanelaBase" BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
    <Setter Property="ExtendsContentIntoTitleBar" Value="True"/>
    <Setter Property="WindowBackdropType" Value="None"/>
    <Setter Property="WindowCornerPreference" Value="Round"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:JanelaBase">
          <AdornerDecorator>
            <ui:ClientAreaBorder Background="{DynamicResource Tema.Fundo}">
              <Grid>
                <Grid x:Name="PART_Raiz" Background="{DynamicResource Tema.Fundo}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <ui:TitleBar Title="{TemplateBinding Title}" ShowMaximize="{TemplateBinding MostrarMaximizar}"
                               ShowMinimize="{TemplateBinding MostrarMinimizar}"/>
                  <!-- Tamanho do texto da Personalização: zoom do conteúdo (LayoutTransform), igual em controles nossos e do WPF UI. -->
                  <ContentPresenter Grid.Row="1" LayoutTransform="{DynamicResource Interface.Escala}"/>
                  <ui:SnackbarPresenter x:Name="PART_Avisos" Grid.Row="1" VerticalAlignment="Bottom" ContentSource=""/>
                  <ui:ContentDialogHost x:Name="PART_Dialogos" Grid.RowSpan="2"/>
                  <c:PaletaDeComandos x:Name="PART_Paleta" Grid.Row="1" Visibility="Collapsed"
                                      VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
                <Image x:Name="PART_Transicao" Visibility="Collapsed" IsHitTestVisible="False" Stretch="Fill"/>
              </Grid>
            </ui:ClientAreaBorder>
          </AdornerDecorator>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
