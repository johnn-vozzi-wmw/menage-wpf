<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Menage</AssemblyName>
    <RootNamespace>Menage.App</RootNamespace>
    <!-- Main próprio: o Velopack precisa rodar antes de qualquer janela (hooks de instalar/atualizar). -->
    <StartupObject>Menage.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="WPF-UI" />
    <ProjectReference Include="..\Menage.Core\Menage.Core.csproj" />
  </ItemGroup>

</Project>
