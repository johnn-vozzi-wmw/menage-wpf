<c:JanelaBase x:Class="Menage.App.JanelaDeAtualizacao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Menage.App.Controles"
        Title="Atualização do Menage" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" MostrarMaximizar="False" MostrarMinimizar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Mensagem" Style="{StaticResource Texto.Corpo}" />
        <ProgressBar x:Name="Barra" Height="14" Margin="0,16,0,0" Maximum="100" Visibility="Collapsed" />
        <StackPanel x:Name="Botoes" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Instalar agora" IsDefault="True" Padding="14,4" Margin="0,0,8,0" Click="Instalar_Click" />
            <Button Content="Depois" IsCancel="True" Padding="14,4" Margin="0,0,8,0" Click="Depois_Click" />
            <Button Content="Ignorar esta versão" Padding="14,4" Click="Ignorar_Click" />
        </StackPanel>
    </StackPanel>
</c:JanelaBase>
