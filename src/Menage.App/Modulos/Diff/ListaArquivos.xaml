<UserControl x:Class="Menage.App.Modulos.Diff.ListaArquivos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EstilosDiff.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource CartaoDiff}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BotaoRecolher" Style="{StaticResource BotaoIconeDiff}" Margin="0" ToolTip="Recolhe a lista de arquivos para dar mais espaço ao diff (Ctrl+B)"
                           Icon="{ui:SymbolIcon PanelLeftContract24}" Click="AoRecolher"/>
                <TextBlock x:Name="Titulo" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:Button x:Name="BotaoAtualizar" Grid.Column="2" Style="{StaticResource BotaoIconeDiff}" ToolTip="Lê de novo os arquivos alterados (F5)"
                           Icon="{ui:SymbolIcon ArrowSync24}" Click="AoAtualizar"/>
            </Grid>
            <ListBox x:Name="Lista" Grid.Row="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="AoSelecionar">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Margin="4,1">
                                        <Border x:Name="Fundo" CornerRadius="6" Background="Transparent"/>
                                        <Border x:Name="Marca" Width="3" CornerRadius="1.5" Margin="0,10" HorizontalAlignment="Left" Visibility="Collapsed"
                                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                        <ContentPresenter Margin="10,2,6,2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="40" ToolTip="{Binding Dica}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="28" HorizontalAlignment="Left" ToolTip="{Binding Descricao}">
                                <Border CornerRadius="5" Background="{Binding FundoLetra}" Margin="0,0,5,3">
                                    <TextBlock Text="{Binding Iniciais}" Foreground="{Binding CorLetra}" FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="12" Height="12" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{Binding CorLetra}">
                                    <TextBlock Text="{Binding Letra}" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Pasta}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
