<UserControl x:Class="Menage.App.Modulos.Diff.ListaArquivos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EstilosDiff.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource CartaoDiff}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BotaoRecolher" Style="{StaticResource BotaoIconeDiff}" Margin="0" ToolTip="Recolhe a lista de arquivos para dar mais espaço ao diff (Ctrl+B)"
                           Icon="{ui:SymbolIcon PanelLeftContract24}" Click="AoRecolher"/>
                <TextBlock x:Name="Titulo" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:Button x:Name="BotaoAtualizar" Grid.Column="2" Style="{StaticResource BotaoIconeDiff}" ToolTip="Lê de novo os arquivos alterados (F5)"
                           Icon="{ui:SymbolIcon ArrowSync24}" Click="AoAtualizar"/>
            </Grid>
            <ListBox x:Name="Lista" Grid.Row="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="AoSelecionar">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="40" ToolTip="{Binding Dica}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="5" Background="{Binding FundoLetra}" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Letra}" Foreground="{Binding CorLetra}" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Pasta}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
