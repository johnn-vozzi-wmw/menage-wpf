<ui:FluentWindow x:Class="Menage.App.Modulos.Diff.JanelaDiff"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="clr-namespace:Menage.App.Modulos.Diff"
                 Width="1500" Height="900" WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen" PreviewKeyDown="AoTecla">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Barra"/>
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColunaLista" Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Canvas x:Name="HospedeiroLista">
                <d:ListaArquivos x:Name="Lista"/>
            </Canvas>
            <Border x:Name="Conteudo" Grid.Column="1" Padding="10,0,0,0" Background="{DynamicResource ApplicationBackgroundBrush}">
                <d:PainelDiff x:Name="Painel"/>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
