<c:JanelaBase x:Class="Menage.App.Modulos.JanelaPrincipal.JanelaDeStashPop"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Stash pop" Width="600" Height="420" WindowStartupLocation="CenterOwner" MostrarMinimizar="False" MostrarMaximizar="False">
  <Grid Margin="20,8,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Escolha os stashes a aplicar (do mais antigo ao mais novo em cada projeto)." Style="{StaticResource Texto.Legenda}"/>
    <ListBox x:Name="Lista" Grid.Row="1" Margin="0,8" Style="{StaticResource Lista.Virtualizada}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox IsChecked="{Binding Marcado}" Content="{Binding Texto}" Margin="2"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <CheckBox x:Name="Manter" Grid.Row="2" Content="Manter na lista (apply em vez de pop)"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
      <Button Content="Aplicar" IsDefault="True" MinWidth="90" Click="AoConfirmar"/>
    </StackPanel>
  </Grid>
</c:JanelaBase>
