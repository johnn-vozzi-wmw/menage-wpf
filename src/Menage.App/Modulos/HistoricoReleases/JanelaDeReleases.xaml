<c:JanelaBase x:Class="Menage.App.Modulos.HistoricoReleases.JanelaDeReleases"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              Title="Histórico de releases" Width="980" Height="680" MinWidth="640" MinHeight="420"
              WindowStartupLocation="CenterOwner" MostrarMinimizar="False">
  <Grid Margin="20,4,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <TextBlock Text="Betas geradas pelo Gerador de Beta (por ambiente) e tags dos projetos marcados, da mais recente para a mais antiga."
               Style="{StaticResource Texto.Legenda}"/>

    <Grid Grid.Row="1" Margin="0,10,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/><ColumnDefinition Width="*" MaxWidth="320"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding Ambientes}" SelectedItem="{Binding Ambiente, Mode=TwoWay}" ToolTip="Ambiente = pasta base onde a beta foi gerada"/>
      <c:CampoDeBusca Grid.Column="1" Margin="8,0,0,0" PlaceholderText="Filtrar por projeto, branch ou tag"
                      Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
        <c:Chip Texto="Betas" IsChecked="{Binding Betas, Mode=TwoWay}" Margin="0,0,6,0"/>
        <c:Chip Texto="Tags" IsChecked="{Binding Tags, Mode=TwoWay}"/>
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{Binding Contagem}" Style="{StaticResource Texto.Legenda}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Cartao.Padrao}" Padding="4">
      <Grid>
        <ListBox x:Name="Lista" ItemsSource="{Binding Linhas}" Style="{StaticResource Lista.Virtualizada}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid MinHeight="64">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Dia}" FontWeight="SemiBold" Foreground="{DynamicResource Tema.Texto}" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding Hora}" Style="{StaticResource Texto.Legenda}" HorizontalAlignment="Right"/>
                </StackPanel>
                <Grid Grid.Column="1">
                  <Rectangle Width="2" Fill="{DynamicResource Tema.Borda}" HorizontalAlignment="Center"/>
                  <c:Bolinha Tom="{Binding Tom}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="2" Margin="6,8,8,8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Tema.TextoForte}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Texto.Legenda}" TextWrapping="Wrap" MaxHeight="48" Margin="0,2,0,0"/>
                </StackPanel>
                <c:Etiqueta Grid.Column="3" Texto="{Binding Ambiente}" Tom="{Binding Tom}" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding TemAmbiente, Converter={x:Static c:Conversores.VisivelSe}}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <c:EstadoVazio Titulo="Nada para mostrar" Descricao="{Binding Vazio}" Icone="History24" IsHitTestVisible="False" VerticalAlignment="Center"
                       Visibility="{Binding SemLinhas, Converter={x:Static c:Conversores.VisivelSe}}"/>
        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Carregando, Converter={x:Static c:Conversores.VisivelSe}}"/>
      </Grid>
    </Border>
  </Grid>
</c:JanelaBase>
