<c:JanelaBase x:Class="Menage.App.Modulos.Banco.JanelaDoBanco"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Contexto do banco de dados" Width="1280" Height="800" MinWidth="1000" MinHeight="640" WindowStartupLocation="CenterOwner">
  <c:JanelaBase.Resources>
    <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Legenda}">
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="CartaoDeConexao" TargetType="Border" BasedOn="{StaticResource Cartao.Padrao}">
      <Setter Property="Padding" Value="16,12,16,14"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
  </c:JanelaBase.Resources>
  <Grid Margin="20,4,20,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,12">
      <TextBlock Text="context.xml" Style="{StaticResource Texto.Legenda}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button DockPanel.Dock="Right" Content="Procurar..." Margin="6,0,0,0" Click="AoProcurar" ToolTip="Escolher o context.xml"/>
      <TextBox Text="{Binding Caminho, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Fonte.Mono}"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/><ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*" MinWidth="380"/><ColumnDefinition Width="16"/>
        <ColumnDefinition Width="400" MinWidth="280"/>
      </Grid.ColumnDefinitions>

      <!-- Perfis -->
      <DockPanel>
        <c:CampoDeBusca DockPanel.Dock="Top" PlaceholderText="Buscar perfil" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button Content="Novo perfil" Command="{Binding NovoCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
          <UniformGrid Columns="2">
            <Button Content="Duplicar" Command="{Binding DuplicarCommand}" IsEnabled="{Binding TemSelecao}" HorizontalAlignment="Stretch" Margin="0,0,3,6"/>
            <Button Content="Excluir" Command="{Binding ExcluirCommand}" IsEnabled="{Binding TemSelecao}" HorizontalAlignment="Stretch" Margin="3,0,0,6"/>
          </UniformGrid>
          <Button Content="Importar do arquivo" Click="AoImportar" HorizontalAlignment="Stretch"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding PerfisFiltrados}" SelectedItem="{Binding Selecionado}" Style="{StaticResource Lista.Virtualizada}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="6,6">
                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource Texto.Legenda}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Formulário -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" FontSize="{StaticResource Fonte.Titulo}" FontWeight="SemiBold" Margin="0,0,0,4"/>

          <Border Style="{StaticResource Cartao.Padrao}" Padding="16,12,16,14" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Tipo" Style="{StaticResource Rotulo}"/>
                <ComboBox ItemsSource="{Binding Tipos}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding Tipo}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Host / IP" Style="{StaticResource Rotulo}"/>
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Porta" Style="{StaticResource Rotulo}"/>
                <TextBox Text="{Binding Porta, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </Grid>
          </Border>

          <!-- WEB -->
          <Border Style="{StaticResource CartaoDeConexao}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <c:Etiqueta Texto="WEB" Tom="GrupoWeb" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <TextBlock Text="Conexão WEB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="LAVENDEREWEBDS" Style="{StaticResource Texto.Legenda}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Usuário" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding WebUsuario, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{Binding RotuloDoBanco}" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding WebBanco, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Senha (já criptografada)" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding WebSenha, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- APP -->
          <Border Style="{StaticResource CartaoDeConexao}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <c:Etiqueta Texto="APP" Tom="GrupoApp" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <TextBlock Text="Conexão APP" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="LAVENDEREPDADS" Style="{StaticResource Texto.Legenda}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Usuário" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding AppUsuario, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding EhOracle, Converter={x:Static c:Conversores.OcultoSe}}"><TextBlock Text="{Binding RotuloDoBanco}" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding AppBanco, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Senha" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding AppSenha, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- INT -->
          <Border Style="{StaticResource CartaoDeConexao}">
            <StackPanel>
              <DockPanel>
                <c:Etiqueta Texto="INT" Tom="GrupoFw" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <ui:ToggleSwitch IsChecked="{Binding IntIgualWeb}" Content="Igual a WEB" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Conexão INT" FontWeight="SemiBold"/>
                  <TextBlock Text="LAVENDEREINTDS" Style="{StaticResource Texto.Legenda}"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="Usa usuário, senha e banco da conexão WEB." Style="{StaticResource Texto.Legenda}" Margin="0,8,0,0"
                         Visibility="{Binding IntIgualWeb, Converter={x:Static c:Conversores.VisivelSe}}"/>
              <Grid Margin="0,10,0,0" Visibility="{Binding MostrarInt, Converter={x:Static c:Conversores.VisivelSe}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Usuário" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding IntUsuario, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding EhOracle, Converter={x:Static c:Conversores.OcultoSe}}"><TextBlock Text="{Binding RotuloDoBanco}" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding IntBanco, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Senha" Style="{StaticResource Rotulo}"/><TextBox Text="{Binding IntSenha, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Prévia do XML: coluna própria, em altura total, para revisar o que será gravado -->
      <Border Grid.Column="4" Style="{StaticResource Cartao.Padrao}" Padding="0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
            <Button Content="Copiar" DockPanel.Dock="Right" Click="AoCopiarPrevia" Padding="10,3"/>
            <StackPanel>
              <TextBlock Text="Prévia do XML" FontWeight="SemiBold"/>
              <TextBlock Text="É o que será gravado no context.xml. Senhas ocultas." Style="{StaticResource Texto.Legenda}"/>
            </StackPanel>
          </DockPanel>
          <Border Background="{DynamicResource Tema.Cartao2}" BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
              <c:XmlDestacado Xml="{Binding Previa}" FontFamily="{StaticResource Fonte.Mono}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                              Foreground="{DynamicResource Tema.Texto}"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Fechar" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
        <Button Content="Salvar" Command="{Binding SalvarCommand}" MinWidth="90" Margin="0,0,8,0"/>
        <ui:Button Content="Salvar e aplicar" Command="{Binding SalvarEAplicarCommand}" MinWidth="130" IsDefault="True" Appearance="Primary"/>
      </StackPanel>
      <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Mensagem}"/>
            <Setter Property="Foreground" Value="{DynamicResource Tema.Verde}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Erro}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Tema.Vermelho}"/></DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions><Condition Binding="{Binding Sujo}" Value="True"/><Condition Binding="{Binding Erro}" Value="False"/></MultiDataTrigger.Conditions>
                <Setter Property="Text" Value="Alterações não salvas"/>
                <Setter Property="Foreground" Value="{DynamicResource Tema.Amarelo}"/>
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DockPanel>
  </Grid>
</c:JanelaBase>
