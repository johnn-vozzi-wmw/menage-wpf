<c:JanelaBase x:Class="Menage.App.Modulos.GeradorBeta.JanelaDeTexto"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Nome" Width="420" Height="210" WindowStartupLocation="CenterOwner" MostrarMinimizar="False" MostrarMaximizar="False">
  <StackPanel Margin="20,8,20,16">
    <TextBlock x:Name="Rotulo" Style="{StaticResource Texto.Legenda}"/>
    <TextBox x:Name="Campo" Margin="0,6,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancelar" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
      <Button Content="Salvar" IsDefault="True" MinWidth="90" Click="AoConfirmar"/>
    </StackPanel>
  </StackPanel>
</c:JanelaBase>
