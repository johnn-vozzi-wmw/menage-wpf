<c:JanelaBase x:Class="Menage.App.Modulos.GeradorBeta.JanelaDeEntrega"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Preparar a entrega?" Width="620" Height="400" WindowStartupLocation="CenterOwner" MostrarMinimizar="False" MostrarMaximizar="False">
  <Grid Margin="20,8,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Subtitulo" TextWrapping="Wrap" Style="{StaticResource Texto.Corpo}"/>
    <TextBlock x:Name="Pasta" Grid.Row="1" Margin="0,12,0,4" TextWrapping="Wrap" Style="{StaticResource Texto.Legenda}"/>
    <ItemsControl x:Name="Itens" Grid.Row="2" Margin="12,0,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Texto}" Margin="0,2" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Tema.Verde}"/>
                <Style.Triggers><DataTrigger Binding="{Binding Falhou}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Tema.Vermelho}"/></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="Rodape" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Texto.Legenda}"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Agora não" IsCancel="True" MinWidth="100" Margin="0,0,8,0"/>
      <Button Content="Preparar entrega" IsDefault="True" MinWidth="130" Click="AoConfirmar"/>
    </StackPanel>
  </Grid>
</c:JanelaBase>
