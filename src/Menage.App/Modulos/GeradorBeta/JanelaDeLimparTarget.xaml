<c:JanelaBase x:Class="Menage.App.Modulos.GeradorBeta.JanelaDeLimparTarget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Limpar target ao gerar" Width="520" Height="560" WindowStartupLocation="CenterOwner" MostrarMinimizar="False" MostrarMaximizar="False">
  <Grid Margin="20,8,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock TextWrapping="Wrap" Style="{StaticResource Texto.Legenda}"
               Text="Habilitado: antes do Maven de cada projeto marcado abaixo, a pasta target do projeto e dos módulos é apagada (só target ao lado de um pom.xml; nunca .git, node_modules nem pastas ocultas). Arquivo em uso vira aviso no log e o build segue."/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
      <ToggleButton x:Name="Habilitado" MinWidth="130" Click="AoAlternar"/>
      <Button Content="Todos" Margin="16,0,0,0" Click="AoMarcarTodos"/>
      <Button Content="Nenhum" Margin="8,0,0,0" Click="AoMarcarNenhum"/>
    </StackPanel>
    <ListBox x:Name="Lista" Grid.Row="2" Style="{StaticResource Lista.Virtualizada}">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,10,0,2" Foreground="{DynamicResource Tema.TextoFraco}"/></DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemTemplate>
        <DataTemplate><CheckBox Content="{Binding Nome}" IsChecked="{Binding Marcado}" Margin="8,2"/></DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="Aviso" Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource Tema.Vermelho}"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancelar" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
      <Button Content="Salvar" IsDefault="True" MinWidth="90" Click="AoConfirmar"/>
    </StackPanel>
  </Grid>
</c:JanelaBase>
