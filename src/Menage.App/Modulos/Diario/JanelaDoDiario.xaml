<c:JanelaBase x:Class="Menage.App.Modulos.Diario.JanelaDoDiario"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Diário de trabalho" Width="1180" Height="820" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterOwner">
  <Grid Margin="20,4,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="150"/>
      <RowDefinition Height="8"/><RowDefinition Height="1.4*" MinHeight="150"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Dia e opções -->
    <DockPanel Margin="0,0,0,8" LastChildFill="False">
      <Button Content="◀" Command="{Binding DiaAnteriorCommand}" ToolTip="Dia anterior" DockPanel.Dock="Left"/>
      <TextBlock Text="{Binding TextoDoDia}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Tema.TextoForte}" VerticalAlignment="Center" Margin="12,0" DockPanel.Dock="Left" MinWidth="230"/>
      <Button Content="▶" Command="{Binding DiaSeguinteCommand}" ToolTip="Próximo dia" DockPanel.Dock="Left"/>
      <Button Content="Hoje" Command="{Binding HojeCommand}" Margin="8,0,0,0" DockPanel.Dock="Left"/>
      <Button Content="Recarregar" Command="{Binding RecarregarCommand}" Margin="8,0,0,0" DockPanel.Dock="Left"/>
      <Button Content="Configurar..." Command="{Binding ConfigurarCommand}" DockPanel.Dock="Right"/>
      <Button Content="Atribuir issue aos commits sem id..." Command="{Binding AtribuirIssueCommand}" Margin="0,0,8,0" DockPanel.Dock="Right"/>
      <CheckBox Content="Um worklog por commit" IsChecked="{Binding PorCommit}" Margin="0,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Right"
                ToolTip="Cada commit com issue vira o seu worklog, com hora e minutos editáveis. Trocar recarrega o dia."/>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="{Binding Motivo}" Style="{StaticResource Texto.Legenda}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Avisos}" Foreground="{DynamicResource Tema.Amarelo}" TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>

    <!-- Worklogs -->
    <DataGrid x:Name="Grade" Grid.Row="2" ItemsSource="{Binding Linhas}" SelectedItem="{Binding Selecionada, Mode=TwoWay}"
              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
              EnableRowVirtualization="True" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Lançar" Binding="{Binding Lancar, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
        <DataGridTextColumn Header="Issue" Binding="{Binding Issue, UpdateSourceTrigger=LostFocus}" Width="120"/>
        <DataGridTextColumn Header="Início" Binding="{Binding Inicio, UpdateSourceTrigger=LostFocus}" Width="70"/>
        <DataGridTextColumn Header="Minutos" Binding="{Binding Minutos, UpdateSourceTrigger=LostFocus}" Width="80"/>
        <DataGridTextColumn Header="Duração" Binding="{Binding Duracao, Mode=OneWay}" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="Título no Jira" Binding="{Binding Titulo, Mode=OneWay}" IsReadOnly="True" Width="*"/>
        <DataGridTextColumn Header="Situação" Binding="{Binding Situacao, Mode=OneWay}" IsReadOnly="True" Width="200"/>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>

    <!-- Detalhe do worklog selecionado -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Commits deste worklog" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ListBox ItemsSource="{Binding CommitsDaLinha}" Style="{StaticResource Lista.Virtualizada}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,3">
                <TextBlock><Run Text="{Binding Hora, Mode=OneWay}" Foreground="{DynamicResource Tema.TextoFraco}"/><Run Text="  "/><Run Text="{Binding Assunto, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                <TextBlock Style="{StaticResource Texto.Legenda}"><Run Text="{Binding Projeto, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Branch, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Hash, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding Arquivos}" Style="{StaticResource Texto.Legenda}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <TextBlock Text="Comentário do worklog" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="Resumir com IA" Command="{Binding ResumirComIaCommand}" DockPanel.Dock="Right" ToolTip="Uma chamada à IA, só para este worklog"/>
          <Button Content="Resumo por regras (este)" Command="{Binding ResumoPorRegrasCommand}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResumoDaIa}" Style="{StaticResource Texto.Legenda}" Margin="0,4,0,0"/>
        <TextBox Text="{Binding Selecionada.Comentario, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 IsEnabled="{Binding Selecionada.Lancado, Converter={x:Static c:Conversores.Inverter}, FallbackValue=False}"/>
      </DockPanel>
    </Grid>

    <!-- Rodapé -->
    <DockPanel Grid.Row="5" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Copiar texto" Command="{Binding CopiarCommand}" Margin="0,0,8,0"/>
        <Button Content="Conferir no Jira" Command="{Binding ConferirNoJiraCommand}" Margin="0,0,8,0" ToolTip="Mostra o título das issues e avisa horas já lançadas (só leitura)"/>
        <Button Content="Lançar no Jira" Command="{Binding LancarCommand}" IsDefault="True" MinWidth="130"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{Binding Total}" FontWeight="SemiBold" Foreground="{DynamicResource Tema.TextoForte}"/>
        <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Legenda}">
              <Style.Triggers><DataTrigger Binding="{Binding MensagemDeErro}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Tema.Vermelho}"/></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DockPanel>
  </Grid>
</c:JanelaBase>
