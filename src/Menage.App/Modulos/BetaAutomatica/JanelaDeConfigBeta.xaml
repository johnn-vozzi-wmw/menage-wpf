<c:JanelaBase x:Class="Menage.App.Modulos.BetaAutomatica.JanelaDeConfigBeta"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Configurar a Beta automática" Width="640" Height="660" WindowStartupLocation="CenterOwner" MostrarMinimizar="False" MostrarMaximizar="False">
  <c:JanelaBase.Resources>
    <Style TargetType="TextBlock" x:Key="Rotulo" BasedOn="{StaticResource Texto.Legenda}"><Setter Property="Margin" Value="0,10,0,2"/></Style>
  </c:JanelaBase.Resources>
  <Grid Margin="20,4,20,16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Jira (endereço)" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="Url"/>
        <TextBlock Text="Variável de ambiente com o token" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="Variavel"/>
        <TextBlock Text="Chaves de projeto do Jira (separadas por vírgula; vazio = todos)" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="Chaves"/>
        <Grid Margin="0,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Status que dispara a beta" Style="{StaticResource Rotulo}"/><TextBox x:Name="Alvo"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Status de finalização automática" Style="{StaticResource Rotulo}"/><TextBox x:Name="Final"/></StackPanel>
        </Grid>
        <TextBlock Text="Consultar a cada (minutos)" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="Intervalo" Width="80" HorizontalAlignment="Left"/>
        <TextBlock Text="Pasta dos clones isolados (seus projetos de trabalho nunca são tocados)" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="Pasta"/>
        <StackPanel x:Name="PainelTester" Visibility="Collapsed">
          <TextBlock Text="Quais atividades monitorar (perfil Tester)" Style="{StaticResource Rotulo}"/>
          <ComboBox x:Name="Escopo" MinWidth="300" HorizontalAlignment="Left">
            <ComboBoxItem Content="Somente atribuídas a mim" Tag="atribuidas"/>
            <ComboBoxItem Content="Qualquer atividade que passar para o status" Tag="todas"/>
          </ComboBox>
          <TextBlock Text="Status de onde a atividade precisa vir (Tester)" Style="{StaticResource Rotulo}"/>
          <TextBox x:Name="CodeReview"/>
        </StackPanel>
        <StackPanel x:Name="PainelDev">
          <TextBlock Text="Status de desenvolvimento e de revisão (regra: era minha quando saiu de um para o outro)" Style="{StaticResource Rotulo}"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Dev"/><TextBox x:Name="Revisao" Grid.Column="2"/>
          </Grid>
          <TextBlock Text="Tipos de subtask de coding" Style="{StaticResource Rotulo}"/>
          <TextBox x:Name="Tipos"/>
        </StackPanel>
        <Button Content="Ordem dos projetos..." Margin="0,16,0,0" HorizontalAlignment="Left" Click="AoOrdem"/>
        <TextBlock x:Name="Aviso" Foreground="{DynamicResource Tema.Vermelho}" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancelar" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
      <Button Content="Salvar" IsDefault="True" MinWidth="90" Click="AoSalvar"/>
    </StackPanel>
  </Grid>
</c:JanelaBase>
