<c:JanelaBase x:Class="Menage.App.Modulos.BetaAutomatica.JanelaDeJql"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="JQL da busca" Width="1000" Height="780" MinWidth="780" MinHeight="600" WindowStartupLocation="CenterOwner" MostrarMinimizar="False">
  <Grid Margin="20,4,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Style="{StaticResource Texto.Legenda}" TextWrapping="Wrap"
               Text="Consultas que o monitor faz no Jira: as padrão (editáveis e restauráveis) e as suas. Quem entra na lista segue as regras de escopo."/>
    <ListBox x:Name="Lista" Grid.Row="1" Style="{StaticResource Lista.Virtualizada}" Margin="0,8,0,0" SelectionChanged="AoSelecionar">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel>
            <CheckBox IsChecked="{Binding Ativa}" Click="AoLigar" DockPanel.Dock="Left" MinWidth="0" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Tipo}" DockPanel.Dock="Right" Style="{StaticResource Texto.Legenda}" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Grid.Row="2" Margin="0,8,0,8">
      <Button Content="Nova" Click="AoNova" Margin="0,0,6,0"/>
      <Button Content="Duplicar" Click="AoDuplicar" Margin="0,0,6,0"/>
      <Button x:Name="Excluir" Content="Excluir" Click="AoExcluir" Margin="0,0,6,0"/>
      <Button x:Name="Restaurar" Content="Restaurar padrão" Click="AoRestaurar" Margin="0,0,6,0"/>
      <Button Content="Restaurar todas" Click="AoRestaurarTodas" Margin="0,0,6,0"/>
      <Button Content="Subir" Click="AoSubir" Margin="0,0,6,0"/>
      <Button Content="Descer" Click="AoDescer"/>
    </WrapPanel>
    <StackPanel Grid.Row="3">
      <TextBlock Text="Nome (só das personalizadas)" Style="{StaticResource Texto.Legenda}"/>
      <TextBox x:Name="Nome" TextChanged="AoMudarNome" Margin="0,2,0,8"/>
      <TextBlock Text="JQL — marcadores: {projeto}, {status}, {escopo} (Tester: só as atribuídas a você)" Style="{StaticResource Texto.Legenda}"/>
    </StackPanel>
    <TextBox x:Name="Jql" Grid.Row="4" Height="90" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource Fonte.Mono}" TextChanged="AoMudarJql" Margin="0,2,0,6" VerticalScrollBarVisibility="Auto"/>
    <WrapPanel Grid.Row="5" Margin="0,0,0,6" x:Name="Trechos"/>
    <StackPanel Grid.Row="6">
      <TextBlock Text="O que vai ao Jira (com os marcadores trocados)" Style="{StaticResource Texto.Legenda}"/>
      <TextBox x:Name="Expandida" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Fonte.Mono}" Margin="0,2,0,6" MinHeight="44"/>
      <DockPanel Margin="0,0,0,6">
        <Button x:Name="Testar" Content="Testar esta JQL" DockPanel.Dock="Right" Click="AoTestar"/>
        <TextBlock x:Name="AvisoJql" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="Resultado do teste (só leitura no Jira: nada é alterado)" Style="{StaticResource Texto.Legenda}"/>
    </StackPanel>
    <TextBox x:Name="Resultado_" Grid.Row="7" Style="{StaticResource Saida.Area}" IsReadOnly="True" Margin="0,2,0,8"/>
    <DockPanel Grid.Row="8">
      <TextBlock x:Name="Erro" Foreground="{DynamicResource Tema.Vermelho}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="Cancelar" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
        <Button Content="Salvar" IsDefault="True" MinWidth="90" Click="AoSalvar"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</c:JanelaBase>
