<UserControl x:Class="Menage.App.Modulos.BetaAutomatica.AbaJql"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Menage.App.Controles"
             xmlns:m="clr-namespace:Menage.App.Modulos.BetaAutomatica">
  <UserControl.Resources>
    <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Legenda}"><Setter Property="Margin" Value="0,12,0,4"/></Style>
    <Style x:Key="AvisoDaJql" TargetType="TextBlock" BasedOn="{StaticResource Texto.Corpo}">
      <Setter Property="Foreground" Value="{DynamicResource Tema.TextoFraco}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding TomDoAviso}" Value="Vermelho"><Setter Property="Foreground" Value="{DynamicResource Tema.Vermelho}"/></DataTrigger>
        <DataTrigger Binding="{Binding TomDoAviso}" Value="Amarelo"><Setter Property="Foreground" Value="{DynamicResource Tema.Amarelo}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ItemDaLista" TargetType="ListBoxItem" BasedOn="{StaticResource Lista.Item}">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <DataTemplate x:Key="ModeloDaConsulta" DataType="{x:Type m:LinhaDeJql}">
      <DockPanel>
        <CheckBox IsChecked="{Binding Ativa}" DockPanel.Dock="Left" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Consulta ligada"/>
        <c:Ficha Texto="{Binding Tipo}" Tom="Neutro" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Style="{StaticResource Cartao.Padrao}" Padding="8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Linhas}" SelectedItem="{Binding Selecionada, Mode=TwoWay}" Style="{StaticResource Lista.Virtualizada}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource ItemDaLista}" ItemTemplate="{StaticResource ModeloDaConsulta}"/>
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
          <ui:Button Content="Nova" Command="{Binding NovaCommand}" Margin="0,0,6,6"/>
          <ui:Button Content="Duplicar" Command="{Binding DuplicarCommand}" Margin="0,0,6,6"/>
          <ui:Button Content="↑ Subir" Command="{Binding SubirCommand}" Margin="0,0,6,6"/>
          <ui:Button Content="↓ Descer" Command="{Binding DescerCommand}" Margin="0,0,6,6"/>
          <ui:Button Content="Excluir" Command="{Binding ExcluirCommand}" Margin="0,0,6,6"/>
        </WrapPanel>
        <ui:Button Grid.Row="2" Content="Restaurar todas" Command="{Binding RestaurarTodasCommand}" HorizontalAlignment="Left"/>
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource Cartao.Padrao}" Padding="0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,6,16,12">
          <StackPanel>
            <TextBlock Text="Nome (só das personalizadas)" Style="{StaticResource Rotulo}"/>
            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding NomeSomenteLeitura}"/>

            <TextBlock Text="JQL — marcadores: {projeto}, {status}, {escopo} (Tester: só as atribuídas a você)" Style="{StaticResource Rotulo}"/>
            <TextBox x:Name="Editor" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding TemSelecao}" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="{StaticResource Fonte.Mono}" MinHeight="84" VerticalScrollBarVisibility="Auto"/>
            <ItemsControl x:Name="Trechos" Margin="0,6,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="Marcadores destacados" Style="{StaticResource Rotulo}"/>
            <Border Background="{DynamicResource Tema.PainelClaro}" CornerRadius="{StaticResource Raio.Etiqueta}" Padding="10,8">
              <m:TextoComMarcadores Trechos="{Binding Trechos}" FontFamily="{StaticResource Fonte.Mono}" FontSize="12" Foreground="{DynamicResource Tema.Texto}" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="O que vai ao Jira (com os marcadores trocados)" Style="{StaticResource Rotulo}"/>
            <TextBox Text="{Binding Expandida, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Fonte.Mono}" MinHeight="44"/>

            <DockPanel Margin="0,12,0,0">
              <ui:Button DockPanel.Dock="Right" Appearance="Primary" Command="{Binding TestarCommand}" Content="{Binding TextoDoTeste}" Margin="12,0,0,0"/>
              <TextBlock Text="{Binding Aviso}" Style="{StaticResource AvisoDaJql}" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Resultado do teste (só leitura no Jira: nada é alterado)" Style="{StaticResource Rotulo}"/>
            <TextBox Text="{Binding ResultadoDoTeste, Mode=OneWay}" Style="{StaticResource Saida.Area}" MinHeight="110" MaxHeight="220"/>
          </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="16,8,16,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <ui:Button Content="Restaurar padrão" Command="{Binding RestaurarCommand}" Margin="0,0,16,0"/>
            <ui:Button Content="Cancelar" Command="{Binding CancelarCommand}" IsEnabled="{Binding Alterado}" MinWidth="90" Margin="0,0,8,0"/>
            <ui:Button Content="Salvar" Command="{Binding SalvarCommand}" IsEnabled="{Binding Alterado}" Appearance="Primary" MinWidth="90"/>
          </StackPanel>
          <TextBlock Text="{Binding Erro}" Foreground="{DynamicResource Tema.Vermelho}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource Tema.Verde}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
