<UserControl x:Class="Menage.App.Modulos.BetaAutomatica.PontoDoMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="8" Height="8" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False">
  <!-- Verde e pulsando com o monitor ativo; âmbar e parado quando pausado. Só opacidade e escala, por tempo. -->
  <UserControl.Resources>
    <Style x:Key="Anel" TargetType="Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Tema.Amarelo}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Opacity" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding MonitorAtivo}" Value="True">
          <Setter Property="Fill" Value="{DynamicResource Tema.Verde}"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Pulso">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.6" Duration="0:0:1.8"/>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.6" Duration="0:0:1.8"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.8"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulso"/></DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Ponto" TargetType="Ellipse">
      <Setter Property="Fill" Value="{DynamicResource Tema.Amarelo}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding MonitorAtivo}" Value="True"><Setter Property="Fill" Value="{DynamicResource Tema.Verde}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Ellipse Style="{StaticResource Anel}"/>
    <Ellipse Style="{StaticResource Ponto}"/>
  </Grid>
</UserControl>
