<c:JanelaBase x:Class="Menage.App.Modulos.BetaAutomatica.JanelaBetaAutomatica"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              xmlns:a="clr-namespace:Menage.App.Animacoes"
              xmlns:m="clr-namespace:Menage.App.Modulos.BetaAutomatica"
              Title="Betas habilitadas" Width="1120" Height="840" MinWidth="860" MinHeight="580" WindowStartupLocation="CenterOwner">
  <c:JanelaBase.Resources>
    <!-- Aba horizontal: texto, contador (vermelho se houver beta com problema) e sublinhado na selecionada -->
    <Style x:Key="CabecalhoDaAba" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Raiz" Padding="14,10" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Cursor="Hand">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Rotulo" Text="{Binding Titulo}" Foreground="{DynamicResource Tema.TextoFraco}" VerticalAlignment="Center"/>
                <c:Ficha Texto="{Binding Contador}" Margin="7,0,0,0" ToolTip="Atividades na lista" Visibility="{Binding TemContador, Converter={x:Static c:Conversores.VisivelSe}}">
                  <c:Ficha.Style>
                    <Style TargetType="c:Ficha" BasedOn="{StaticResource {x:Type c:Ficha}}">
                      <Setter Property="Tom" Value="Neutro"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Alerta}" Value="True"><Setter Property="Tom" Value="Vermelho"/></DataTrigger></Style.Triggers>
                    </Style>
                  </c:Ficha.Style>
                </c:Ficha>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rotulo" Property="Foreground" Value="{DynamicResource Tema.Texto}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Rotulo" Property="Foreground" Value="{DynamicResource Tema.TextoForte}"/>
                <Setter TargetName="Raiz" Property="BorderBrush" Value="{DynamicResource Tema.Destaque}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </c:JanelaBase.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Abas à esquerda e o status do monitor à direita, visível em qualquer aba -->
    <Border Background="{DynamicResource Tema.Painel}" BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="0,1,0,1" Padding="10,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,4,0">
          <m:PontoDoMonitor Margin="0,0,8,0"/>
          <TextBlock Text="{Binding StatusCurto}" Style="{StaticResource Texto.Legenda}" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Status}"/>
        </StackPanel>
        <ListBox x:Name="Abas" ItemsSource="{Binding Abas}" SelectedItem="{Binding AbaSelecionada, Mode=TwoWay}" ItemContainerStyle="{StaticResource CabecalhoDaAba}"
                 Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
      </DockPanel>
    </Border>

    <a:HospedeDeTransicao x:Name="Hospede" Grid.Row="1" Margin="20,12,20,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

    <m:DockDoConsole x:Name="Dock" Grid.Row="2" DataContext="{Binding Console}"/>
  </Grid>
</c:JanelaBase>
