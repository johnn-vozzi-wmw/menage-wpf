<UserControl x:Class="Menage.App.Modulos.BetaAutomatica.AbaDiagnostico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Menage.App.Controles"
             xmlns:core="clr-namespace:Menage.Core.BetaAutomatica;assembly=Menage.Core">
  <UserControl.Resources>
    <Style x:Key="IconeGira" TargetType="ui:SymbolIcon">
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><RotateTransform/></Setter.Value></Setter>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Simulando}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Giro">
              <Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/></Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Giro"/></DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ModeloDoPasso" DataType="{x:Type core:PassoDaDecisao}">
      <Grid Margin="0,0,6,4">
        <c:Ficha Texto="{Binding Texto, StringFormat='✓ {0}'}" Tom="Verde" Visibility="{Binding Ok, Converter={x:Static c:Conversores.VisivelSe}}"/>
        <c:Ficha Texto="{Binding Texto, StringFormat='✕ {0}'}" Tom="Vermelho" Visibility="{Binding Ok, Converter={x:Static c:Conversores.OcultoSe}}"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ModeloDaDecisao" DataType="{x:Type core:DecisaoDaBusca}">
      <Border Style="{StaticResource Cartao.Padrao}" Padding="14,10" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Margin="0,2,12,0" VerticalAlignment="Top">
            <c:Ficha Texto="✓" Tom="Verde" Visibility="{Binding Entra, Converter={x:Static c:Conversores.VisivelSe}}"/>
            <c:Ficha Texto="–" Tom="Neutro" Visibility="{Binding Entra, Converter={x:Static c:Conversores.OcultoSe}}"/>
          </Grid>
          <StackPanel Grid.Column="1">
            <TextBlock TextWrapping="Wrap">
              <Run Text="{Binding Chave, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Tema.TextoForte}"/><Run Text="  "/><Run Text="{Binding Titulo, Mode=OneWay}"/>
              <Run Text="  "/><Run Text="{Binding Decisao, Mode=OneWay}" Foreground="{DynamicResource Tema.TextoFraco}" FontSize="11"/>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Passos}" ItemTemplate="{StaticResource ModeloDoPasso}" Margin="0,6,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Expander Header="Detalhes" Margin="0,4,0,0">
              <ItemsControl ItemsSource="{Binding Detalhes}" Margin="8,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Texto.Legenda}" FontFamily="{StaticResource Fonte.Mono}"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Margin="0,0,12,0">
      <Border Style="{StaticResource Cartao.Padrao}" Padding="16,14" Margin="0,0,0,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Appearance="Primary" Command="{Binding SimularCommand}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowSync24" Style="{StaticResource IconeGira}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding TextoDoBotao}"/>
              </StackPanel>
            </ui:Button>
            <ui:Button Content="Copiar" Command="{Binding CopiarCommand}" Margin="8,0,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Simular a busca" FontWeight="SemiBold"/>
            <TextBlock Text="Usa as mesmas consultas e regras do ciclo real e não altera nada (sem fetch, sem alerta)." Style="{StaticResource Texto.Legenda}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Cartao.Padrao}" Padding="16,24" Visibility="{Binding MostrarOrientacao, Converter={x:Static c:Conversores.VisivelSe}}">
        <TextBlock Text="Rode a simulação para ver, atividade por atividade, por que entra ou não na lista." Style="{StaticResource Texto.Legenda}" HorizontalAlignment="Center"/>
      </Border>

      <StackPanel Visibility="{Binding TemRelatorio, Converter={x:Static c:Conversores.VisivelSe}}">
        <TextBlock Text="{Binding CabecalhoTexto}" Style="{StaticResource Texto.Legenda}" FontFamily="{StaticResource Fonte.Mono}" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding Contagem}" Style="{StaticResource Texto.Legenda}" Margin="0,0,0,8"/>
        <ItemsControl ItemsSource="{Binding Decisoes}" ItemTemplate="{StaticResource ModeloDaDecisao}"/>
        <TextBlock Text="{Binding RodapeTexto}" Style="{StaticResource Texto.Legenda}" FontFamily="{StaticResource Fonte.Mono}" Margin="0,4,0,12"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
