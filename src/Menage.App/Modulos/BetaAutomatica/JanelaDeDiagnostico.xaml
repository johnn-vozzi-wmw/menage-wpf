<c:JanelaBase x:Class="Menage.App.Modulos.BetaAutomatica.JanelaDeDiagnostico"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Diagnóstico da busca" Width="980" Height="720" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="20,4,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <Button x:Name="Executar" Content="Simular a busca" DockPanel.Dock="Left" Click="AoExecutar"/>
      <Button Content="Copiar" DockPanel.Dock="Left" Margin="8,0,0,0" Click="AoCopiar"/>
      <TextBlock Text="Simulação: usa as mesmas consultas e regras do ciclo real e não altera nada (sem fetch, sem alerta)." Style="{StaticResource Texto.Legenda}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <TextBox x:Name="Texto" Grid.Row="1" Style="{StaticResource Saida.Area}" IsReadOnly="True"/>
  </Grid>
</c:JanelaBase>
