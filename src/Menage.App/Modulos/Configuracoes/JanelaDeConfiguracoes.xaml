<c:JanelaBase x:Class="Menage.App.Modulos.Configuracoes.JanelaDeConfiguracoes"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Configurações" Width="1060" Height="760" MinWidth="860" MinHeight="580" WindowStartupLocation="CenterOwner">
  <c:JanelaBase.Resources>
    <Style x:Key="Painel" TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="Secao" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,16,16"/></Style>
    <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource Texto.Legenda}"><Setter Property="Margin" Value="0,14,0,4"/></Style>
    <Style x:Key="Ajuda" TargetType="TextBlock" BasedOn="{StaticResource Texto.Legenda}">
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="MensagemDeConfiguracao" TargetType="TextBlock" BasedOn="{StaticResource Texto.Legenda}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Tema.Vermelho}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </c:JanelaBase.Resources>

  <Grid Margin="20,4,20,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <ListBox x:Name="Navegacao" Grid.Row="0" Grid.Column="0" Style="{StaticResource Lista.Virtualizada}" SelectionChanged="AoMudarSecao">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="8,5"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="0" Grid.Column="2">
      <!-- 0: Perfil de uso -->
      <ScrollViewer x:Name="Painel0" Style="{StaticResource Painel}">
        <StackPanel Style="{StaticResource Secao}">
          <TextBlock Text="Perfil de uso" Style="{StaticResource Texto.Subtitulo}"/>
          <TextBlock Style="{StaticResource Ajuda}" Text="O perfil libera ou bloqueia funcionalidades na interface (conveniência e redução de risco; não é segurança). Vale ao salvar."/>
          <TextBlock Text="Perfil ativo" Style="{StaticResource Rotulo}"/>
          <ComboBox ItemsSource="{Binding Perfis}" SelectedItem="{Binding PerfilEscolhido}" DisplayMemberPath="Nome" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"/>
          <TextBlock Text="{Binding DescricaoDoPerfil}" Style="{StaticResource Ajuda}"/>
          <Button Content="Gerenciar perfis..." Command="{Binding GerenciarPerfisCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>

      <!-- 1: Git -->
      <ScrollViewer x:Name="Painel1" Style="{StaticResource Painel}">
        <StackPanel Style="{StaticResource Secao}">
          <TextBlock Text="Git" Style="{StaticResource Texto.Subtitulo}"/>
          <TextBlock Text="{Binding VersaoDoGit}" Style="{StaticResource Ajuda}"/>
          <TextBlock Text="{Binding ModoSsh}" Style="{StaticResource Ajuda}" Margin="0,2,0,0"/>
          <TextBlock Text="Ferramenta de diff (botão direito no projeto > Ver diff)" Style="{StaticResource Rotulo}"/>
          <ComboBox ItemsSource="{Binding Diffs}" SelectedItem="{Binding Diff}" DisplayMemberPath="Nome" MinWidth="280" HorizontalAlignment="Left"/>
          <TextBlock Text="Fetch automático" Style="{StaticResource Rotulo}"/>
          <ui:ToggleSwitch IsChecked="{Binding FetchAutomatico}" Content="Rodar git fetch --all em segundo plano" HorizontalAlignment="Left"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="A cada" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding FetchMinutos, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <TextBlock Text="minutos (1 a 240)" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource Texto.Legenda}"/>
          </StackPanel>
          <CheckBox Content="Incluir tags no Fetch manual (lembra a última escolha)" IsChecked="{Binding FetchComTags}" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <!-- 2: Caminhos -->
      <ScrollViewer x:Name="Painel2" Style="{StaticResource Painel}">
        <StackPanel Style="{StaticResource Secao}">
          <TextBlock Text="Caminhos" Style="{StaticResource Texto.Subtitulo}"/>
          <TextBlock Text="Pasta raiz dos projetos (com web, framework e pda)" Style="{StaticResource Rotulo}"/>
          <DockPanel>
            <Button Content="Alterar..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="AoEscolherRaiz"/>
            <TextBox Text="{Binding Raiz, Mode=OneWay}" IsReadOnly="True"/>
          </DockPanel>
          <TextBlock Style="{StaticResource Ajuda}" Text="Trocar a raiz procura os projetos de novo. Quem usa projetos em outras pastas gerencia em Gerenciar projetos."/>
          <TextBlock Text="Chave SSH (sem a extensão .ppk; vazio = a padrão do usuário)" Style="{StaticResource Rotulo}"/>
          <DockPanel>
            <Button Content="Escolher..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="AoEscolherChave"/>
            <TextBox Text="{Binding ChaveSsh, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <TextBlock Text="WinMerge (WinMergeU.exe; vazio = procurar nos lugares de costume)" Style="{StaticResource Rotulo}"/>
          <DockPanel>
            <Button Content="Escolher..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="AoEscolherWinMerge"/>
            <TextBox Text="{Binding WinMerge, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <TextBlock Text="Pasta bin do TortoiseGit (vazio = procurar nos lugares de costume)" Style="{StaticResource Rotulo}"/>
          <DockPanel>
            <Button Content="Escolher..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="AoEscolherTortoise"/>
            <TextBox Text="{Binding TortoiseGit, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- 3: Jira e credenciais -->
      <ScrollViewer x:Name="Painel3" Style="{StaticResource Painel}">
        <StackPanel Style="{StaticResource Secao}">
          <TextBlock Text="Jira" Style="{StaticResource Texto.Subtitulo}"/>
          <TextBlock Text="Endereço" Style="{StaticResource Rotulo}"/>
          <TextBox Text="{Binding JiraUrl, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Projetos reconhecidos nas mensagens e branches (separados por vírgula; vazio = qualquer CHAVE-123)" Style="{StaticResource Rotulo}"/>
          <TextBox Text="{Binding JiraProjetos, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Variável de ambiente do token (usada quando não há token guardado abaixo)" Style="{StaticResource Rotulo}"/>
          <TextBox Text="{Binding JiraVariavel, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" HorizontalAlignment="Left"/>

          <TextBlock Text="Credenciais deste usuário do Windows" Style="{StaticResource Texto.Subtitulo}" Margin="0,26,0,0"/>
          <TextBlock Style="{StaticResource Ajuda}" Text="Ficam em credenciais.json protegidas pelo Windows (DPAPI): só você, neste computador, consegue abrir. Nunca aparecem na tela nem nos logs. Deixe o segredo em branco para trocar só o usuário."/>
          <ItemsControl ItemsSource="{Binding Credenciais}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Cartao.Padrao}" Margin="0,0,0,10" Padding="14,10">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                      <TextBlock Text="{Binding Estado}" Style="{StaticResource Texto.Legenda}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Usuário" Style="{StaticResource Texto.Legenda}"/>
                        <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding RotuloDoSegredo}" Style="{StaticResource Texto.Legenda}"/>
                        <PasswordBox x:Name="Segredo" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button Content="Guardar" Click="AoGuardarCredencial" Tag="{Binding ElementName=Segredo}" Margin="0,0,6,0"/>
                        <Button Content="Remover" Command="{Binding DataContext.RemoverCredencialCommand, RelativeSource={RelativeSource AncestorType=c:JanelaBase}}"
                                CommandParameter="{Binding}" IsEnabled="{Binding Guardada}"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- 4: Proteção -->
      <ScrollViewer x:Name="Painel4" Style="{StaticResource Painel}">
        <StackPanel Style="{StaticResource Secao}">
          <TextBlock Text="Proteção de branches e convenção de commit" Style="{StaticResource Texto.Subtitulo}"/>
          <TextBlock Style="{StaticResource Ajuda}" Text="Vale só dentro do Menage: nenhum hook é instalado nos repositórios."/>
          <CheckBox Content="Bloquear push nas branches protegidas" IsChecked="{Binding BloquearPush}" Margin="0,14,0,0"/>
          <CheckBox Content="Bloquear exclusão das branches protegidas" IsChecked="{Binding BloquearExclusao}" Margin="0,8,0,0"/>
          <TextBlock Text="Branches protegidas (uma por linha; * vale como curinga, ex.: release*)" Style="{StaticResource Rotulo}"/>
          <TextBox Text="{Binding BranchesProtegidas, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="5" MaxLines="8" VerticalScrollBarVisibility="Auto"/>
          <CheckBox Content="Validar a mensagem do commit (desligado por padrão)" IsChecked="{Binding ValidarCommit}" Margin="0,16,0,0"/>
          <TextBlock Text="Tipos aceitos (separados por vírgula): feat:, fix(escopo): ..." Style="{StaticResource Rotulo}"/>
          <TextBox Text="{Binding TiposDeCommit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ValidarCommit}"/>
          <CheckBox Content="Aceitar também chave de ticket (VENDAS-123: mensagem)" IsChecked="{Binding AceitarTicket}" IsEnabled="{Binding ValidarCommit}" Margin="0,10,0,0"/>
          <Button Content="Restaurar padrão" Command="{Binding RestaurarProtecaoCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>

      <!-- 5: Comportamento -->
      <ScrollViewer x:Name="Painel5" Style="{StaticResource Painel}">
        <StackPanel Style="{StaticResource Secao}">
          <TextBlock Text="Comportamento" Style="{StaticResource Texto.Subtitulo}"/>
          <TextBlock Text="Tema (vale na hora; Ctrl+T alterna entre claro e escuro)" Style="{StaticResource Rotulo}"/>
          <ComboBox ItemsSource="{Binding Temas}" SelectedItem="{Binding Tema}" DisplayMemberPath="Nome" MinWidth="280" HorizontalAlignment="Left"/>
          <CheckBox Content="Verificar atualização ao abrir o Menage" IsChecked="{Binding VerificarAtualizacao}" Margin="0,16,0,0"/>
          <CheckBox Content="Começar com a Saída da janela principal recolhida" IsChecked="{Binding SaidaRecolhida}" Margin="0,10,0,0"/>

          <TextBlock Text="Script da atividade (merge e cherry-pick)" Style="{StaticResource Texto.Subtitulo}" Margin="0,26,0,0"/>
          <TextBlock Style="{StaticResource Ajuda}" Text="A atividade commita o script de alterações do banco no lavenderecore. Ao levar o commit para a develop o script NÃO vai junto; na branch da atividade ele continua."/>
          <CheckBox Content="Não levar o script da atividade para a develop" IsChecked="{Binding ScriptExcluir}" Margin="0,12,0,0"/>
          <TextBlock Text="Arquivo do script (caminho relativo ao repositório; * e %NOME_BRANCH% valem como curinga)" Style="{StaticResource Rotulo}"/>
          <TextBox Text="{Binding ScriptPadrao, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ScriptExcluir}"/>
          <TextBlock Text="Branches de destino em que o script é retirado (separadas por vírgula; * é curinga)" Style="{StaticResource Rotulo}"/>
          <TextBox Text="{Binding ScriptDestinos, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ScriptExcluir}"/>
        </StackPanel>
      </ScrollViewer>

      <!-- 6: Importar do Git Manager -->
      <ScrollViewer x:Name="Painel6" Style="{StaticResource Painel}">
        <StackPanel Style="{StaticResource Secao}">
          <TextBlock Text="Importar do Git Manager antigo" Style="{StaticResource Texto.Subtitulo}"/>
          <TextBlock Style="{StaticResource Ajuda}" Text="Ação sua, item por item. A pasta antiga só é LIDA: nada nela é alterado, movido ou apagado. As credenciais do Nexus são reprotegidas para este usuário do Windows; o token do Jira não é importado."/>
          <TextBlock Text="Pasta do Git Manager (onde ficam perfil.json, preferencias.json, os .cfg)" Style="{StaticResource Rotulo}"/>
          <DockPanel>
            <Button Content="Escolher..." DockPanel.Dock="Right" Margin="8,0,0,0" Click="AoEscolherPastaAntiga"/>
            <Button Content="Procurar em C:\wmw" DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding ProcurarInstalacoesCommand}"/>
            <TextBox Text="{Binding PastaAntiga, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding InstalacoesAntigas}" Style="{StaticResource Lista.Virtualizada}" MaxHeight="120" Margin="0,8,0,0" SelectionChanged="AoEscolherInstalacao"
                   Visibility="{Binding TemInstalacoes, Converter={x:Static c:Conversores.VisivelSe}}"/>
          <Button Content="Ver o que há na pasta" Command="{Binding AnalisarCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
          <ItemsControl ItemsSource="{Binding Achados}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <CheckBox IsChecked="{Binding Marcado}" IsEnabled="{Binding Encontrado}">
                    <StackPanel>
                      <TextBlock Text="{Binding Titulo}"/>
                      <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Texto.Legenda}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </CheckBox>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Importar os marcados" Command="{Binding ImportarCommand}" IsEnabled="{Binding TemAchados}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
          <TextBox Text="{Binding RelatorioDaImportacao, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinLines="3" Margin="0,12,0,0"
                   Visibility="{Binding TemRelatorio, Converter={x:Static c:Conversores.VisivelSe}}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Mensagem}" Style="{StaticResource MensagemDeConfiguracao}" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Descartar alterações" Command="{Binding DescartarCommand}" Margin="0,0,8,0"/>
        <Button Content="Salvar" Command="{Binding SalvarCommand}" MinWidth="100" Margin="0,0,8,0" IsDefault="True"/>
        <Button Content="Fechar" IsCancel="True" MinWidth="90"/>
      </StackPanel>
    </Grid>
  </Grid>
</c:JanelaBase>
