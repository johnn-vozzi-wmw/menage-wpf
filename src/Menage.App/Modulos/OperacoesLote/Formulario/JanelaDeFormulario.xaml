<c:JanelaBase x:Class="Menage.App.Modulos.OperacoesLote.Formulario.JanelaDeFormulario"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:Menage.App.Controles"
              Title="Operação" Width="640" Height="540" WindowStartupLocation="CenterOwner" MostrarMinimizar="False" MostrarMaximizar="False">
  <Grid Margin="20,8,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Descricao" Style="{StaticResource Texto.Legenda}" TextWrapping="Wrap"/>
    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Corpo" Margin="0,0,8,0"/>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
      <Button x:Name="Confirmar" Content="OK" IsDefault="True" MinWidth="90" Click="AoConfirmar"/>
    </StackPanel>
  </Grid>
</c:JanelaBase>
