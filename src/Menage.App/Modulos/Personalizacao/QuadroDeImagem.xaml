<UserControl x:Class="Menage.App.Modulos.Personalizacao.QuadroDeImagem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Menage.App.Modulos.Personalizacao">
  <!-- Coluna 2: quadro 200x200 em xadrez, zoom, nome do arquivo, zona de soltar arquivo e as ações. -->
  <Border Style="{StaticResource Cartao.Padrao}">
    <StackPanel>
      <TextBlock Text="2. IMAGEM OU GIF" Style="{StaticResource Texto.Legenda}" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Border Width="200" Height="200" CornerRadius="12" BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="1" Background="{DynamicResource Tema.Cartao2}" ClipToBounds="True">
        <Grid>
          <Border Opacity="0.5">
            <Border.Background>
              <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                  <GeometryDrawing Brush="{DynamicResource Tema.Borda}" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z"/>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Border.Background>
          </Border>
          <p:IconePrevia Estica="UniformToFill"/>
        </Grid>
      </Border>

      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <TextBlock Text="Zoom" Style="{StaticResource Texto.Legenda}" VerticalAlignment="Center"/>
        <Slider Grid.Column="1" Minimum="50" Maximum="200" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Margin="8,0"
                IsEnabled="{Binding TemIcone}" Value="{Binding ZoomPercentual, Delay=120}" AutomationProperties.Name="Zoom do ícone"/>
        <TextBlock Grid.Column="2" Text="{Binding ZoomTexto}" Style="{StaticResource Texto.Legenda}" VerticalAlignment="Center" TextAlignment="Right"/>
      </Grid>

      <TextBlock Text="{Binding NomeDoArquivo}" Style="{StaticResource Texto.Legenda}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource Tema.Vermelho}" Style="{StaticResource Texto.Legenda}" TextWrapping="Wrap" TextAlignment="Center"/>

      <Grid x:Name="Zona" Margin="0,10,0,0" Height="64" AllowDrop="True" Cursor="Hand" Tag=""
            MouseLeftButtonUp="AoClicarNaZona" DragOver="AoArrastarSobre" DragLeave="AoSairDoArrasto" Drop="AoSoltar">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tema.GradeSel}"/></Trigger>
              <Trigger Property="Tag" Value="sobre"><Setter Property="Background" Value="{DynamicResource Tema.GradeSel}"/></Trigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="4 3" Stroke="{DynamicResource Tema.Borda}" IsHitTestVisible="False"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="{Binding TextoDaZona}" FontWeight="SemiBold" Foreground="{DynamicResource Tema.Texto}" HorizontalAlignment="Center"/>
          <TextBlock Text="ou solte um arquivo aqui" Style="{StaticResource Texto.Legenda}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <WrapPanel Margin="0,10,0,0">
        <Button Content="Escolher imagem..." Command="{Binding EscolherImagemCommand}" Margin="0,0,8,6"/>
        <Button Content="Remover" Command="{Binding RemoverCommand}" Margin="0,0,8,6"/>
        <Button Content="Usar em todos os temas" Command="{Binding UsarEmTodosCommand}" Margin="0,0,0,6"
                ToolTip="Copia este ícone e o zoom para todos os outros temas"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
