<UserControl x:Class="Menage.App.Modulos.Personalizacao.AbaIcones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Menage.App.Modulos.Personalizacao"
             SizeChanged="AoMudarTamanho">
  <UserControl.Resources>
    <DataTemplate x:Key="LinhaDeIconeModelo" DataType="{x:Type p:LinhaDeIcone}">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Nome}" Foreground="{DynamicResource Tema.Texto}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Resumo}" Style="{StaticResource Texto.Legenda}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
        <Button Grid.Column="2" Content="Escolher..." Command="{Binding DataContext.EscolherCommand, RelativeSource={RelativeSource AncestorType=p:AbaIcones}}" CommandParameter="{Binding}"/>
        <Button Grid.Column="3" Content="Remover" Margin="6,0,0,0" Command="{Binding DataContext.RemoverItemCommand, RelativeSource={RelativeSource AncestorType=p:AbaIcones}}" CommandParameter="{Binding}"
                IsEnabled="{Binding TemIcone}"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
    <StackPanel>
      <TextBlock Text="Imagem ou GIF (PNG, JPG, BMP, ICO, GIF). O ícone vale por tema; o zoom escolhido fica gravado junto com ele." Style="{StaticResource Texto.Legenda}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <!-- 3 colunas; em janela estreita (menos de 980 px) viram uma coluna só (AoMudarTamanho). -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="Col1" Width="230"/><ColumnDefinition x:Name="Col2" Width="1.2*"/><ColumnDefinition x:Name="Col3" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <p:ListaDeTemas x:Name="Tema" Grid.Column="0" Margin="0,0,7,0" VerticalAlignment="Top"/>
        <p:QuadroDeImagem x:Name="Imagem" Grid.Column="1" Margin="7,0" VerticalAlignment="Top"/>
        <p:OndeAparece x:Name="Onde" Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Top"/>
      </Grid>

      <Expander Header="Ícone por comando, grupo e projeto (avançado)" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Só valem com as caixas de &quot;Onde aparece&quot; marcadas." Style="{StaticResource Texto.Legenda}" Margin="0,4,0,6"/>
          <Expander Header="Comandos (menu e pílulas)" IsEnabled="{Binding AplicarNoMenuEPilulas}">
            <ListBox ItemsSource="{Binding Comandos}" ItemTemplate="{StaticResource LinhaDeIconeModelo}" Style="{StaticResource Lista.Virtualizada}" MaxHeight="260" HorizontalContentAlignment="Stretch"/>
          </Expander>
          <Expander Header="Grupos" IsEnabled="{Binding AplicarEmGruposEProjetos}">
            <ItemsControl ItemsSource="{Binding Grupos}" ItemTemplate="{StaticResource LinhaDeIconeModelo}"/>
          </Expander>
          <Expander Header="Projetos" IsEnabled="{Binding AplicarEmGruposEProjetos}">
            <ListBox ItemsSource="{Binding Projetos}" ItemTemplate="{StaticResource LinhaDeIconeModelo}" Style="{StaticResource Lista.Virtualizada}" MaxHeight="260" HorizontalContentAlignment="Stretch"/>
          </Expander>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
