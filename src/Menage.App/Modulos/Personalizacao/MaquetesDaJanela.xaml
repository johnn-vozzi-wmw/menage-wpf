<UserControl x:Class="Menage.App.Modulos.Personalizacao.MaquetesDaJanela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Menage.App.Modulos.Personalizacao">
  <!-- Maquete da janela (barra de título, lateral com o logo, conteúdo) e da barra de tarefas, nas cores do tema escolhido. -->
  <StackPanel>
    <Border CornerRadius="8" BorderBrush="{DynamicResource Tema.Borda}" BorderThickness="1" ClipToBounds="True" Background="{Binding FundoDaMaquete}">
      <StackPanel>
        <DockPanel Background="{Binding BarraDaMaquete}" Height="26">
          <p:IconePrevia Width="16" Height="16" Margin="8,0,6,0" DockPanel.Dock="Left"/>
          <TextBlock Text="Menage" Foreground="{Binding TextoDaMaquete}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBlock Text="—  ▢  ✕" Foreground="{Binding TextoDaMaquete}" FontSize="11" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Height="84">
          <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Background="{Binding BarraDaMaquete}">
            <p:IconePrevia Width="24" Height="24" Margin="6,6,6,4" HorizontalAlignment="Left"/>
            <Border Height="6" CornerRadius="3" Opacity="0.5" Background="{Binding TextoDaMaquete}" Margin="6,2"/>
            <Border Height="6" CornerRadius="3" Opacity="0.5" Background="{Binding TextoDaMaquete}" Margin="6,2"/>
            <Border Height="6" CornerRadius="3" Opacity="0.5" Background="{Binding DestaqueDaMaquete}" Margin="6,2"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8">
            <Border Height="8" CornerRadius="3" Opacity="0.35" Background="{Binding DestaqueDaMaquete}" Width="64" HorizontalAlignment="Left" Margin="0,0,0,5"/>
            <Border Height="8" CornerRadius="3" Opacity="0.35" Background="{Binding TextoDaMaquete}" Margin="0,0,0,5"/>
            <Border Height="8" CornerRadius="3" Opacity="0.35" Background="{Binding TextoDaMaquete}" Margin="0,0,40,5"/>
            <Border Height="8" CornerRadius="3" Opacity="0.35" Background="{Binding TextoDaMaquete}" Margin="0,0,70,0"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Border CornerRadius="6" Background="{DynamicResource Tema.Cartao2}" Padding="8,4" Margin="0,6,0,0">
      <StackPanel Orientation="Horizontal">
        <p:IconePrevia Width="18" Height="18"/>
        <TextBlock Text="Barra de tarefas do Windows" Style="{StaticResource Texto.Legenda}" Margin="6,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
