<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Grade de 4 px. Os tokens de cor (Tema.*) vêm de DicionarioDoTema; os de movimento, de Animacao.cs. -->
  <sys:Double x:Key="Espaco.P">4</sys:Double>
  <sys:Double x:Key="Espaco.M">8</sys:Double>
  <sys:Double x:Key="Espaco.G">16</sys:Double>
  <sys:Double x:Key="Espaco.GG">24</sys:Double>

  <CornerRadius x:Key="Raio.Controle">8</CornerRadius>
  <CornerRadius x:Key="Raio.Etiqueta">6</CornerRadius>
  <CornerRadius x:Key="Raio.Pilula">8</CornerRadius>
  <CornerRadius x:Key="Raio.Chip">14</CornerRadius>

  <sys:Double x:Key="Fonte.Legenda">12</sys:Double>
  <sys:Double x:Key="Fonte.Corpo">14</sys:Double>
  <sys:Double x:Key="Fonte.Subtitulo">16</sys:Double>
  <sys:Double x:Key="Fonte.Titulo">20</sys:Double>
  <FontFamily x:Key="Fonte.Mono">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="Altura.Controle">32</sys:Double>
  <Thickness x:Key="Margem.Cartao">14</Thickness>

  <Style x:Key="Texto.Titulo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Fonte.Titulo}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Tema.TextoForte}"/>
  </Style>
  <Style x:Key="Texto.Subtitulo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Fonte.Subtitulo}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Tema.Texto}"/>
  </Style>
  <Style x:Key="Texto.Corpo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}"/>
    <Setter Property="Foreground" Value="{DynamicResource Tema.Texto}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Texto.Legenda" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}"/>
    <Setter Property="Foreground" Value="{DynamicResource Tema.TextoFraco}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
</ResourceDictionary>
