<Window x:Class="Menage.Pocs.Janela.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Menage.Pocs.Comum;assembly=Pocs.Comum"
        Title="Menage - prova de conceito da janela sem barra de título" Width="900" Height="560"
        MinWidth="420" MinHeight="260" WindowStartupLocation="CenterScreen" Background="#FF1F2328" Foreground="#FFE6EDF3">
    <Border x:Name="Raiz" Background="#FF1F2328">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <c:BarraTitulo Background="#FF2D333B" Foreground="#FFE6EDF3"/>
            <StackPanel Grid.Row="1" Margin="24">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Janela sem barra de título (WindowChrome)"/>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Arraste pela barra, use as bordas e cantos para redimensionar, dê duplo clique na barra para maximizar e encoste nas bordas da tela (ou Win+setas) para encaixar."/>
                <TextBlock x:Name="Estado" Margin="0,16,0,0" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
